<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Dimensions_must_be_positive</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
  Width__c &lt;= 0,
  Height__c &lt;= 0,
  Depth__c &lt;= 0
)</errorConditionFormula>
    <errorMessage>Width, height, and depth must be greater than zero.</errorMessage>
</ValidationRule>
